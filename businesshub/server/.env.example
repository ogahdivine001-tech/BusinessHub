# Copy to .env and fill in. NEVER commit .env or share it (zip, chat, email).
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Optional: extra allowed browser origins, comma-separated (staging/preview sites).
# If unset, the original production site is still allowed for backward compatibility.
ALLOWED_ORIGINS=

MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Added in the stability/security pass ---------------------------------
# Signing key for invoice/receipt share links. Falls back to JWT_SECRET if unset.
DOC_LINK_SECRET=
# How long a shared PDF link stays valid (days). Default 90.
DOC_LINK_TTL_DAYS=90
# Old unsigned /pdf links keep working while this is not "false". Set to false
# once customers have had time to receive refreshed links.
LEGACY_PUBLIC_PDF_LINKS=true
# Days of access after a paid period ends before dropping to Free. Default 0.
PLAN_GRACE_DAYS=0

# --- Added in Step 2 ----------------------------------------------------------
# Customer (buyer) accounts. Open by default; set to false to close customer sign-up.
ENABLE_BUYER_SIGNUP=true
# Verification fee. Leave BLANK until the amount and currency are confirmed;
# paid verification stays off until both are set AND the switch is true.
# Amount is in the currency's smallest unit (NGN: 500000 kobo = 5,000 naira).
VERIFICATION_FEE_MINOR=
VERIFICATION_CURRENCY=
VERIFICATION_PAYMENT_ENABLED=false

# --- Added in Step 3 ----------------------------------------------------------
# Reviews need a confirmed email by default (blunts fake accounts). Set false to relax.
REVIEWS_REQUIRE_VERIFIED_EMAIL=true
# Ranking: reviews needed to appear in "Top rated" / count as established (default 3),
# and how strongly new businesses are pulled toward the platform average (default 5).
RANKING_MIN_REVIEWS=3
RANKING_PRIOR_WEIGHT=5

# --- Added in Steps 4 and 5 ----------------------------------------------------
# Starter product cap (products in total, active at once). Default 100.
STARTER_PRODUCT_LIMIT=100
# Starter: AI invoice + receipt writing per month, combined. Default 50.
STARTER_AI_DOCUMENTS_PER_MONTH=50
# (Verification fee settings are above: VERIFICATION_FEE_MINOR / _CURRENCY / _PAYMENT_ENABLED.
#  Leave them blank until the fee and currency are confirmed.)

# --- Added in Phase 11 (AI assistant) ------------------------------------------
# Seconds-long waits for the AI provider are cut off after this many milliseconds. Default 30000.
AI_TIMEOUT_MS=30000

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AI_PROVIDER=groq
AI_MODEL=
OPENAI_API_KEY=
GROQ_API_KEY=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
STARTER_PRICE_KOBO=200000
PRO_PRICE_KOBO=500000
