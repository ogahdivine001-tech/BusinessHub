# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/businesshub

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI — pick ONE provider by setting AI_PROVIDER, then fill in ONLY that
# provider's key below. AI_MODEL is optional; each provider has a sensible
# default if left blank.
#   openai   -> needs OPENAI_API_KEY   (platform.openai.com — paid, no free tier)
#   groq     -> needs GROQ_API_KEY     (console.groq.com — free, no card needed)
#   deepseek -> needs DEEPSEEK_API_KEY (platform.deepseek.com — 5M free tokens, then very cheap)
#   gemini   -> needs GEMINI_API_KEY   (aistudio.google.com — free tier)
AI_PROVIDER=groq
AI_MODEL=

OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
